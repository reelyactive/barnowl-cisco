#!/usr/bin/env node

const BarnowlCisco = require('../lib/barnowlcisco.js');

const DECODING_OPTIONS = {};
const LISTENER_OPTIONS = { url: "mqtt://localhost",
                           topic: "cisco/iotorchestrator/v1/#" };

let barnowl = new BarnowlCisco();

console.log('Subscribing to topic', LISTENER_OPTIONS.topic, 'on',
            LISTENER_OPTIONS.url);

barnowl.addListener(BarnowlCisco.MqttListener, LISTENER_OPTIONS);

barnowl.on('raddec', (raddec) => {
  console.log(raddec.toFlattened());
});

barnowl.on('infrastructureMessage', (infrastructureMessage) => {
  console.log(infrastructureMessage);
});
